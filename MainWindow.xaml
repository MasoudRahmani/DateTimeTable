<Window x:Class="DateTimeTable.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DateTimeTable"
        mc:Ignorable="d"
        Title="Date Time Table Creator"
        Height="640"
        MaxHeight="800"
        MaxWidth="900"
        Width="800"
        FontFamily="Segoe UI">

    <Grid x:Name="MainGrid" Background="#F3F4F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: app icon, title, language selector -->
        <Border Grid.Row="0" Background="#0B5FFF" CornerRadius="0,0,8,8" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Globe icon -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                    <TextBlock Text="🌐" FontSize="22" Margin="4" Foreground="#FFFFED2E"  />
                    <TextBlock x:Name="HeaderTitleText" Text="DateTime Table" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>

                <!-- Spacer and subtitle -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock x:Name="HeaderSubtitleText" Text="Create calendar tables quickly" Foreground="White" Opacity="0.95" />
                </StackPanel>

                <!-- Language selector -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="LanguageLabel" Text="Language:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="LanguageCombo" Width="120" SelectedIndex="0" SelectionChanged="LanguageCombo_SelectionChanged">
                        <ComboBoxItem Content="English" />
                        <ComboBoxItem Content="فارسی" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left panel: connection and table info -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="14" Margin="0,0,12,0">
                <StackPanel VerticalAlignment="Top">
                    <TextBlock x:Name="ConnectionHeader" Text="Connection" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,4">
                        <TextBlock Text="🖥️" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FF157F07" />
                        <TextBlock x:Name="ServerLabel" Text="Server:" FontSize="14" VerticalAlignment="Center" Margin="0,0,3,0" FontWeight="Bold"/>
                        <ComboBox x:Name="ServersCombo" MinWidth="220" MaxWidth="230" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  IsEditable="True" Text="{Binding SelectedServer, Mode=TwoWay}" SelectionChanged="ServersCombo_SelectionChanged" />
                        <Button x:Name="BrowseServerButton" Content="🔍" Click="BrowseServers_Click" 
                                BorderThickness="0" Foreground="#FF0BADAA" Background="Transparent" Margin="8,0,0,0" />
                    </StackPanel>

                    <Button x:Name="Testbtn" Content="Load Databases" Height="32" Margin="0,8,0,8" Click="Fill_databases"
                            HorizontalAlignment="Center" BorderThickness="0,2,0,2" BorderBrush="BlueViolet" />

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <TextBlock Text="🗄️" FontSize="18" VerticalAlignment="Center" />
                        <TextBlock x:Name="DatabaseLabel" Text="Database:" FontSize="14" VerticalAlignment="Center" Margin="0,0,3,0" FontWeight="Bold" />
                        <ComboBox x:Name="Databases" Height="30" SelectedValue="{Binding SelectedDatebase}" Background="AliceBlue"
                                  MaxHeight="255" MinWidth="200" HorizontalAlignment="Center" VerticalAlignment="Center" IsEnabled="False" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <TextBlock Text="🔒" FontSize="18" VerticalAlignment="Center" />
                        <TextBlock x:Name="SecurityLabel" Text="Security:" FontSize="14" VerticalAlignment="Center" Margin="0,0,3,0" FontWeight="Bold"/>
                        <CheckBox x:Name="Integrated" IsEnabled="{Binding IntegratedEnable}" IsChecked="{Binding IntegratedChecked}" 
                                  Content="Integrated Security" Unchecked="GetCredentialEvent" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="📋" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TableNameLabel" Text="Table Name:" FontSize="14" VerticalAlignment="Center" Margin="0,0,3,0" FontWeight="Bold" />
                        <TextBox x:Name="TableNameTextBox" Text="{Binding TableName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200" MaxWidth="250" Height="32" />
                    </StackPanel>

                    <Separator Margin="0,12" />

                    <TextBlock x:Name="ActionsTextBlock" Text="Actions" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,6" />
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Button x:Name="CreateTableButton" Content="Create Table" Width="140" Height="36" Click="StartToCreate" VerticalAlignment="Center" IsEnabled="False" />
                        <TextBlock x:Name="FlowTipText" Text="Please load databases first." Foreground="Red" Margin="6,8,0,0" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Right panel: date range and description -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="14">
                <StackPanel>
                    <TextBlock x:Name="CalendarRangeTextBlock" Text="Calendar Range" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock x:Name="StartLabel" Text="Start" FontWeight="Medium" />
                            <DatePicker x:Name="StartDatePicker" Width="160" Height="30" SelectedDateFormat="Long" />
                        </StackPanel>

                        <StackPanel Margin="12,0,0,0">
                            <TextBlock x:Name="EndLabel" Text="End" FontWeight="Medium" />
                            <DatePicker x:Name="EndDatePicker" Width="160" Height="30" SelectedDateFormat="Long" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="DescriptionTextBlock" Text="Description" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,6" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.85" FontSize="13" x:Name="DescriptionBody">
                        This application creates a calendar table in the selected database. Choose the server and database, set your date range, and press Create Table. Existing table names will be checked to avoid duplicates.
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock x:Name="TipIcon" Text="📌" FontSize="14" VerticalAlignment="Top" Margin="0,2,8,0" />
                        <TextBlock x:Name="TipTextBlock" Text="Tip: Use the Browse button to auto-detect local SQL Server instances." TextWrapping="Wrap" />
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>
        <!-- Footer: progress and status -->
        <Border Grid.Row="2" Background="Transparent" Padding="10">
            <StackPanel>
                <StatusBar>
                    <StatusBarItem>
                        <TextBlock x:Name="StatusText" Text="Ready" />
                    </StatusBarItem>
                </StatusBar>
                <ProgressBar x:Name="Progressbar" Minimum="0" Height="6" VerticalAlignment="Center" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

    </Grid>
</Window>

